{
  "name": "@local/react-dock",
  "version": "0.0.0",
  "private": true,
  "description": "Responsive React navigation dock with tooltips and paginated item groups",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-package.mjs",
    "dev": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build:demo": "vite build --config vite.demo.config.ts",
    "check:size": "node scripts/check-size.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:size && npm run build:demo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mantine/code-highlight": "^9.7.5",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-select": "^2.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
